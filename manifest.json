{
  "name": "wind chimes",
  "manifest_version": 3,
  "version": "0.5",
  "description": "A breeze of packets blowing through chimes",
  "action": {
    "default_popup": "volume.html"
  },
  "permissions": [
    "webRequest",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/",
    "https://*/"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
